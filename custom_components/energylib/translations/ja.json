  "issues": {
    "confirm_control": {
      "title": "自動で追加された EnergyLIB インバーターを確認",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "これはご自宅のインバーターですか？",
            "description": "{host} の EnergyLIB インバーター {serial} が自動で追加されました。ご自宅のインバーターであることを確認すると、EMS モード、電源のオン・オフ、バッテリー設定の制御が許可されます。制御を許可するには「送信」を選択してください。"
          }
        },
        "abort": {
          "entry_removed": "このインバーターは削除されました。"
        }
      }
    },
    "replace_inverter": {
      "title": "EnergyLIB インバーターを交換しましたか？",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "{old} を {new} に置き換えますか？",
            "description": "{old} がオフラインで、新しい EnergyLIB インバーター {new} が見つかりました。交換した場合は「送信」を選んでください。新しいインバーターが古いものの履歴、エネルギーダッシュボード、エリア、オートメーション、制御設定を引き継ぎ、古いものは削除されます。{new} を追加しただけの場合は、これを無視し、検出されたデバイスから追加してください。",
            "data": {
              "old": "交換されたインバーター"
            }
          }
        },
        "abort": {
          "entry_removed": "このインバーターは削除されました。",
          "already_added": "新しいインバーターはすでに追加されています。",
          "old_online": "古いインバーターがオンラインに戻ったため、置き換えていません。"
        }
      }
    }
  }
