{
  "title": "EnergyLIB",
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "EnergyLIB に接続",
        "description": "EnergyLIB データロガーの Modbus TCP アドレスを入力してください。新しい機器では制御がオンになっており、統合のオプションでオフにできます。",
        "data": {
          "host": "IP アドレスまたはホスト名",
          "port": "Modbus TCP ポート",
          "unit_id": "Modbus ユニット ID"
        }
      },
      "discovery_confirm": {
        "title": "EnergyLIB 機器の確認",
        "description": "**ロガー SN:** {logger_sn}\n\n**ロガー型式:** {logger_model}\n\n**ロガーファームウェア:** {logger_firmware}\n\nこれらの情報はロガーが通知したものです。インバーターの SN は接続時に別途確認します。下の接続設定を確認してください。制御は既定でオンになっており、統合のオプションでオフにできます。",
        "data": {
          "host": "IP アドレスまたはホスト名",
          "port": "Modbus TCP ポート",
          "unit_id": "Modbus ユニット ID"
        }
      },
      "aecc_confirm": {
        "title": "EnergyLIB デバイスを追加",
        "description": "**シリアル番号：** {serial}\n\n**アドレス：** {host}:{port}\n\nローカルネットワーク上の EnergyLIB デバイスです。電力とバッテリー残量の読み取り用に追加されます。制御に対応している場合は、後からオプションで許可できます。電力の向きはこの種類の実機でまだ確認していません。"
      }
    },
    "error": {
      "cannot_connect": "機器を読み取れません。アドレス、ポート、ユニット ID を確認してください。",
