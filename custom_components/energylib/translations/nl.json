  "issues": {
    "confirm_control": {
      "title": "Bevestig de automatisch toegevoegde EnergyLIB-omvormer",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Is dit jouw omvormer?",
            "description": "EnergyLIB-omvormer {serial} op {host} is automatisch toegevoegd. Bevestig dat dit jouw omvormer is om bediening toe te staan: EMS-modus, aan/uit en batterij-instellingen. Kies Verzenden om bediening toe te staan."
          }
        },
        "abort": {
          "entry_removed": "Deze omvormer is verwijderd."
        }
      }
    },
    "replace_inverter": {
      "title": "Is een EnergyLIB-omvormer vervangen?",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "{old} vervangen door {new}?",
            "description": "{old} is offline en er is een nieuwe EnergyLIB-omvormer gevonden: {new}. Hebt u de omvormer vervangen, kies dan Verzenden: de nieuwe neemt de geschiedenis, het energiedashboard, de ruimte, de automatiseringen en de bedieningsinstelling van de oude over, en de oude wordt verwijderd. Is {new} een extra omvormer, negeer dit dan en voeg hem toe bij de gevonden apparaten.",
            "data": {
              "old": "Vervangen omvormer"
            }
          }
        },
        "abort": {
          "entry_removed": "Deze omvormer is verwijderd.",
          "already_added": "De nieuwe omvormer is al toegevoegd.",
          "old_online": "De oude omvormer is weer online, er is niets vervangen."
        }
      }
    }
