  "issues": {
    "confirm_control": {
      "title": "Automatisch hinzugefügten EnergyLIB-Wechselrichter bestätigen",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Ist dies Ihr Wechselrichter?",
            "description": "Der EnergyLIB-Wechselrichter {serial} unter {host} wurde automatisch hinzugefügt. Bestätigen Sie, dass es sich um Ihren Wechselrichter handelt, um die Steuerung freizugeben: EMS-Modus, Ein-/Ausschalten und Batterieeinstellungen. Wählen Sie Absenden, um die Steuerung zu erlauben."
          }
        },
        "abort": {
          "entry_removed": "Dieser Wechselrichter wurde entfernt."
        }
      }
    },
    "replace_inverter": {
      "title": "Wurde ein EnergyLIB-Wechselrichter ersetzt?",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "{old} durch {new} ersetzen?",
            "description": "{old} ist offline und ein neuer EnergyLIB-Wechselrichter, {new}, wurde gefunden. Wenn Sie den Wechselrichter ersetzt haben, wählen Sie Absenden: Der neue übernimmt Verlauf, Energie-Dashboard, Raum, Automationen und Steuerungseinstellung des alten, und der alte wird entfernt. Ist {new} ein zusätzlicher Wechselrichter, ignorieren Sie dies und fügen Sie ihn stattdessen unter den gefundenen Geräten hinzu.",
            "data": {
              "old": "Ersetzter Wechselrichter"
            }
          }
        },
        "abort": {
          "entry_removed": "Dieser Wechselrichter wurde entfernt.",
          "already_added": "Der neue Wechselrichter wurde bereits hinzugefügt.",
          "old_online": "Der alte Wechselrichter ist wieder online, es wurde nichts ersetzt."
        }
      }
    }
