        "step": {
          "confirm": {
            "title": "Sostituire {old} con {new}?",
            "description": "{old} è offline ed è stato trovato un nuovo inverter EnergyLIB, {new}. Se hai sostituito l’inverter, scegli Invia: il nuovo eredita cronologia, dashboard energia, stanza, automazioni e impostazione di controllo del vecchio, che viene rimosso. Se {new} è un inverter aggiuntivo, ignora questo messaggio e aggiungilo dai dispositivi rilevati.",
            "data": {
              "old": "Inverter sostituito"
            }
          }
        },
