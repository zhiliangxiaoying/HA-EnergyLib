    "replace_inverter": {
      "title": "¿Se ha sustituido un inversor EnergyLIB?",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "¿Sustituir {old} por {new}?",
            "description": "{old} está sin conexión y se encontró un nuevo inversor EnergyLIB, {new}. Si sustituyó el inversor, elija Enviar: el nuevo hereda el historial, el panel de energía, la habitación, las automatizaciones y el ajuste de control del antiguo, que se elimina. Si {new} es un inversor adicional, ignore esto y añádalo desde los dispositivos descubiertos.",
            "data": {
              "old": "Inversor sustituido"
            }
          }
        },
        "abort": {
          "entry_removed": "Este inversor se ha eliminado.",
          "already_added": "El nuevo inversor ya se añadió.",
