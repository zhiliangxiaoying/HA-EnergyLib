{
  "title": "EnergyLIB",
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Connect EnergyLIB",
        "description": "Enter the Modbus TCP address of the EnergyLIB data logger. Controls are on for new devices and can be turned off in the integration options.",
        "data": {
          "host": "IP address or hostname",
          "port": "Modbus TCP port",
          "unit_id": "Modbus unit ID"
        }
      },
      "discovery_confirm": {
        "title": "Confirm EnergyLIB device",
        "description": "**Logger SN:** {logger_sn}\n\n**Logger model:** {logger_model}\n\n**Logger firmware:** {logger_firmware}\n\nThese details are advertised by the logger. The inverter SN is checked separately when connecting. Confirm the connection settings below. Controls are on by default and can be turned off in the integration options.",
        "data": {
          "host": "IP address or hostname",
          "port": "Modbus TCP port",
          "unit_id": "Modbus unit ID"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot read the device. Check address, port and unit ID.",
      "unsupported_device": "The device does not match this profile.",
      "identity_mismatch": "Device identity does not match discovery."
    },
    "abort": {
      "already_configured": "Device already configured.",
      "already_in_progress": "Configuration is already in progress.",
      "identity_mismatch": "Device identity does not match discovery.",
      "unsupported_discovery": "Unsupported transport, authentication or discovery contract."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "EnergyLIB settings",
        "menu_options": {
          "control": "Control access",
          "tou": "Time-of-use schedule"
        }
      },
      "control": {
        "title": "Control access",
        "description": "On for newly added devices. Controls the inverter supports (EMS mode, SOC, grid charging, export limit) are shown; turning this on or off does not change any device setting by itself.",
        "data": {
          "allow_control": "Allow control"
        }
      },
      "tou": {
        "title": "Time-of-use draft",
        "description": "Edits stay in the draft until Save.",
        "menu_options": {
          "add": "Add period",
          "edit": "Edit period",
          "delete": "Delete period",
          "settings": "Weekdays and outside mode",
          "save": "Preview and save"
        }
      },
      "settings": {
        "title": "Schedule settings",
        "data": {
          "weekdays": "Weekdays",
          "outside_mode": "Outside-period mode"
        }
      },
      "save": {
        "title": "Save schedule",
        "description": "Draft:\n{preview}\nA multi-frame save is not atomic. A failure can leave a partial plan.",
        "data": {
          "activate": "Switch to time-of-use after saving"
        }
      },
      "add": {
        "title": "Add period",
        "data": {
          "type": "Type",
          "start": "Start",
          "end": "End",
          "power": "Power (kW)"
        }
      },
      "edit_period": {
        "title": "Edit period",
        "data": {
          "type": "Type",
          "start": "Start",
          "end": "End",
          "power": "Power (kW)"
        }
      },
      "edit": {
        "title": "Choose period",
        "data": {
          "period": "Period"
        }
      },
      "delete": {
        "title": "Choose period",
        "data": {
          "period": "Period"
        }
      }
    },
    "error": {
      "control_unverified": "This device does not expose the control registers.",
      "cannot_connect": "Cannot read the device. Check address, port and unit ID.",
      "invalid_schedule": "Invalid periods, overlap, weekdays or power.",
      "command_failed": "Save failed or may be partially applied. Inspect actual device state before retrying."
    },
    "abort": {
      "control_unverified": "This device does not expose the control registers.",
      "cannot_connect": "Cannot read the device. Check address, port and unit ID.",
      "command_failed": "Save failed or may be partially applied. Reopen options to read the actual device plan before retrying."
